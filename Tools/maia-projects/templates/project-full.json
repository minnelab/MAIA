            "<model>": {"label_info": {"params": {"label_info": [{"name": "liver", "model_name": "<model>"}]}},
                        "host": "https://monailabel.example.org"}
        },
        "nvflare_dashboard_admin_username:EXAMPLE": "<user>",
        "nvflare_dashboard_admin_password:EXAMPLE": "<password>",
        "env": {
            "DEPLOY_KUBEFLOW:EXAMPLE": "True",
            "DEPLOY_EHRBASE:EXAMPLE": "True",
            "DEPLOY_NVFLARE_DASHBOARD:EXAMPLE": "True",
            "enable_cifs:EXAMPLE": "True",
