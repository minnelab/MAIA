            "maia_workspace_version:EXAMPLE-BASE-TIER": "1.8.1",
            "maia_workspace_pro_image:EXAMPLE": "maiacloudai/ubuntu-rdp",
            "maia_workspace_pro_version:EXAMPLE": "1.0.1",
            "hub_image:EXAMPLE": "<registry>/maia-jupyterhub",
            "hub_tag:EXAMPLE": "<tag>",
            "maia_monai_toolkit_image:EXAMPLE": "<registry>/maia-monai-toolkit:<tag>",
            "maia_orthanc_image:EXAMPLE": "<registry>/maia-orthanc",
            "maia_orthanc_version:EXAMPLE": "<tag>",
            "MAIA_PRIVATE_REGISTRY:EXAMPLE": "<registry>",
            "ORTHANC_CPU_REQUEST:EXAMPLE": "4000m",
