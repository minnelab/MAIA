{
    "namespace": "full-example",
    "email": "admin@example.org",
    "supervisor": "pi@example.org",
    "users": ["researcher@example.org", "student@example.org"],
    "description": "Every configurable option. Keys with ':' are disabled examples: remove the ':...' suffix to enable one.",
    "date": "2027-12-31",
    "cluster": "maia-dsp",
    "project_tier": "Pro",
    "gpu": "NO",
    "memory_limit": "8 Gi",
    "memory_request": "4 Gi",
    "cpu_limit": "4",
    "cpu_request": "500m",
    "auto_deploy": false,
    "auto_deploy_apps": [],
    "email_to_username_map": {
        "pi@example.org": "pi",
        "researcher@example.org": "researcher",
        "student@example.org": "student"
    },
    "project_configuration": {
        "gpu_request:EXAMPLE": "1",
        "node_selector:EXAMPLE": {"kubernetes.io/hostname": "node-1"},
        "admins:EXAMPLE": ["pi@example.org"],
        "password:EXAMPLE": "<workspace-password>",
        "allow_ssh_password_authentication:EXAMPLE": "True",
        "active_server_limit:EXAMPLE": 1,
        "concurrent_spawn_limit:EXAMPLE": 1,
        "shared_server_user:EXAMPLE": "user@maia.se",
        "jupyterhub_extraEnv:EXAMPLE": {"INSTALL_SLICER": "1"},
