        "mlflow_password:EXAMPLE": "<password>",
        "minio_user:EXAMPLE": "<user>",
        "minio_password:EXAMPLE": "<password>",
        "mysql_user:EXAMPLE": "<user>",
        "mysql_password:EXAMPLE": "<password>",
        "ae_title:EXAMPLE": "FULLEXAMPLE",
